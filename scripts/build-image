#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
FIBER_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"
source "$FIBER_ROOT/scripts/lib/fiber-image.sh"

usage() {
	cat <<'USAGE'
Usage: scripts/build-image [options]

Assemble a bootable UEFI Fiber live ISO from a staged rootfs, kernel, and
initrd. This is a custom image pipeline and does not use Nix or NixOS.

Options:
  --target TARGET    x86_64/amd64 or aarch64/arm64. Defaults to host arch.
  --rootfs PATH      Rootfs directory. Defaults to dist/rootfs/TARGET.
  --kernel PATH      Kernel image. Defaults to dist/kernel/TARGET/vmlinuz.
  --initrd PATH      Initrd image. Defaults to dist/kernel/TARGET/initrd.img.
  --work-dir PATH    Scratch directory. Defaults to dist/iso-work/TARGET.
  --out PATH         ISO path. Defaults to dist/fiberos-TARGET.iso.
  -h, --help         Show this help.

Example:
  scripts/build-image --target x86_64
USAGE
}

target="$(fiber_host_target)"
rootfs=""
kernel=""
initrd=""
out_iso=""
work_dir=""

while [[ $# -gt 0 ]]; do
	case "$1" in
		--target)
			[[ $# -ge 2 ]] || fiber_die "--target requires a value"
			target="$(fiber_normalize_target "$2")"
			shift 2
			;;
		--rootfs)
			[[ $# -ge 2 ]] || fiber_die "--rootfs requires a value"
			rootfs="$2"
			shift 2
			;;
		--kernel)
			[[ $# -ge 2 ]] || fiber_die "--kernel requires a value"
			kernel="$2"
			shift 2
			;;
		--initrd)
			[[ $# -ge 2 ]] || fiber_die "--initrd requires a value"
			initrd="$2"
			shift 2
			;;
		--out)
			[[ $# -ge 2 ]] || fiber_die "--out requires a value"
			out_iso="$2"
			shift 2
			;;
		--work-dir)
			[[ $# -ge 2 ]] || fiber_die "--work-dir requires a value"
			work_dir="$2"
			shift 2
			;;
		-h | --help)
			usage
			exit 0
			;;
		*)
			fiber_die "unknown option '$1'"
			;;
	esac
done

target="$(fiber_normalize_target "$target")"
rootfs="${rootfs:-$FIBER_ROOT/dist/rootfs/$target}"
kernel="${kernel:-$FIBER_ROOT/dist/kernel/$target/vmlinuz}"
initrd="${initrd:-$FIBER_ROOT/dist/kernel/$target/initrd.img}"
out_iso="${out_iso:-$FIBER_ROOT/dist/fiberos-$target.iso}"
work_dir="${work_dir:-$FIBER_ROOT/dist/iso-work/$target}"
iso_root="$work_dir/iso"
efi_boot_img="$work_dir/efiboot.img"
grub_cfg="$work_dir/grub.cfg"
grub_platform="$(fiber_target_grub_platform "$target")"
efi_binary="$(fiber_target_efi_binary "$target")"
volume_id="FIBER_${target^^}"

fiber_require_linux_for_iso
fiber_need_tool mksquashfs
fiber_need_tool grub-mkstandalone
fiber_need_tool mkfs.vfat
fiber_need_tool mmd
fiber_need_tool mcopy
fiber_need_tool xorriso

[[ -d "$rootfs" ]] || fiber_die "rootfs does not exist: $rootfs"
[[ -f "$kernel" ]] || fiber_die "kernel does not exist: $kernel"
[[ -f "$initrd" ]] || fiber_die "initrd does not exist: $initrd"

rm -rf "$work_dir"
mkdir -p "$iso_root/boot/grub" "$iso_root/live" "$iso_root/EFI/BOOT"

fiber_info "creating SquashFS rootfs"
mksquashfs "$rootfs" "$iso_root/live/filesystem.squashfs" -noappend -comp zstd

cp "$kernel" "$iso_root/boot/vmlinuz"
cp "$initrd" "$iso_root/boot/initrd.img"

cat > "$grub_cfg" <<'EOF'
set timeout=5
set default=0

menuentry "Fiber OS" {
	linux /boot/vmlinuz boot=live components live-media-path=/live quiet
	initrd /boot/initrd.img
}
EOF

cp "$grub_cfg" "$iso_root/boot/grub/grub.cfg"

fiber_info "building $grub_platform EFI bootloader"
grub-mkstandalone \
	-O "$grub_platform" \
	-o "$work_dir/$efi_binary" \
	"boot/grub/grub.cfg=$grub_cfg"

dd if=/dev/zero of="$efi_boot_img" bs=1M count=32 status=none
mkfs.vfat "$efi_boot_img" >/dev/null
mmd -i "$efi_boot_img" ::/EFI
mmd -i "$efi_boot_img" ::/EFI/BOOT
mcopy -i "$efi_boot_img" "$work_dir/$efi_binary" "::/EFI/BOOT/$efi_binary"

cp "$work_dir/$efi_binary" "$iso_root/EFI/BOOT/$efi_binary"
cp "$efi_boot_img" "$iso_root/EFI/efiboot.img"

mkdir -p "$(dirname "$out_iso")"
fiber_info "creating ISO at $out_iso"
xorriso \
	-as mkisofs \
	-iso-level 3 \
	-full-iso9660-filenames \
	-volid "$volume_id" \
	-eltorito-alt-boot \
	-e EFI/efiboot.img \
	-no-emul-boot \
	-output "$out_iso" \
	"$iso_root"
fiber_info "ISO created at $out_iso"
